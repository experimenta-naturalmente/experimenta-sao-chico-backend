# Porta do servidor HTTP
PORT=

# Credenciais do Firebase Admin (Firestore).
# Opção A: cole o JSON da service account (uma linha) nesta variável:
FIREBASE_SERVICE_ACCOUNT=
# Opção B: caminho para o arquivo da service account (usado se FIREBASE_SERVICE_ACCOUNT estiver vazio):
GOOGLE_APPLICATION_CREDENTIALS=

# MinIO (compatível com S3)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=
# URL pública por onde as imagens são servidas (sem barra no final)
MINIO_PUBLIC_URL=

# Origens permitidas no CORS (separadas por vírgula). Use * para liberar tudo.
CORS_ORIGINS=

# Se true, exige Firebase ID token (Authorization: Bearer) nas rotas de escrita
REQUIRE_AUTH=
