# Copie para .env no diretório do docker-compose no VPS e preencha.

# Imagens publicadas no GHCR pelos workflows (minúsculo!)
IMAGE_API=ghcr.io/SEU_USUARIO/experimenta-saochico-api:latest
IMAGE_WEB=ghcr.io/SEU_USUARIO/experimenta-saochico-web:latest

# Credenciais do MinIO (também usadas como access/secret pelo backend)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha-forte
MINIO_BUCKET=experiencias
MINIO_REGION=us-east-1
# URL pública base do MinIO (SEM o bucket; o backend anexa /bucket/key)
MINIO_PUBLIC_URL=https://minio.experimentasaochico.com.br

# Service account do Firebase em UMA linha (JSON com \n escapados)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# CORS: origens permitidas (web + dev)
CORS_ORIGINS=https://experimentasaochico.com.br,http://localhost:8080
REQUIRE_AUTH=true
